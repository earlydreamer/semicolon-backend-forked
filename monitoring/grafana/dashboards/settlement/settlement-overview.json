{
  "title": "Settlement Overview",
  "timezone": "Asia/Seoul",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "정산 생성 건수 (시간당)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(business_settlement_created_total{application=\"semicolon\"}[1h])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "정산 금액 추이 (KRW)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(business_settlement_amount_total{application=\"semicolon\"}[5m]))",
          "legendFormat": "Total Amount",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKRW"
        }
      }
    },
    {
      "id": 3,
      "title": "판매자별 정산 금액 (Top 10)",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (seller_id) (business_settlement_amount_total{application=\"semicolon\"}))",
          "legendFormat": "Seller {{seller_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyKRW"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 4,
      "title": "정산 재처리 비율",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(business_settlement_retry_total{application=\"semicolon\"}[5m]) / rate(business_settlement_created_total{application=\"semicolon\"}[5m]) * 100",
          "legendFormat": "Retry Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "정산 상태 분포",
      "type": "piechart",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (business_settlement_created_total{application=\"semicolon\"})",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 6,
      "title": "정산 처리 시간 (P95)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(business_settlement_processing_time_seconds_bucket{application=\"semicolon\"}[5m])) by (le, status))",
          "legendFormat": "P95 - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    }
    ,
    {
      "id": 7,
      "title": "이상거래 탐지 건수 (타입별)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(settlement_anomaly_detected_total{application=\"semicolon\"}[1h])) by (type)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "심각도별 이상거래 분포",
      "type": "piechart",
      "gridPos": {
        "x": 14,
        "y": 24,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (severity) (settlement_anomaly_detected_total{application=\"semicolon\"})",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CRITICAL" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "HIGH" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        },
        "pieType": "donut"
      }
    },
    {
      "id": 9,
      "title": "최근 CRITICAL 이상거래",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(settlement_anomaly_detected_total{application=\"semicolon\", severity=\"CRITICAL\"}[1h]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "Value", "desc": true }]
          }
        }
      ]
    }
  ],
  "uid": "settlement-overview",
  "version": 2
}
