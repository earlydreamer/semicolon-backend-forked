# GitHub Actions Secrets example
#
# 이 파일은 `.env.example`와 겹치지 않는 GitHub Actions 전용 secret만 정리합니다.
# 런타임/배포 설정값은 먼저 `.env.example`를 채우고, 같은 키 이름으로 GitHub Secrets에 등록합니다.
#
# 경로:
# - 앱/배포 설정 예시: `.env.example`
# - CI 접속/배포 전용 secret 예시: `github-actions-secrets.example.env`

# ----- CI/CD only -----
# Docker Hub 로그인용 사용자명입니다.
DOCKER_USERNAME=change-me-docker-username
# 실제 계정 비밀번호가 아니라 Docker Hub access token을 넣습니다.
DOCKER_PASSWORD=change-me-docker-access-token
# ssh로 붙을 때 사용자명
M1_DEPLOY_USER=change-me-remote-user
# Cloudflare Tunnel을 통해 SSH로 붙을 공개 hostname입니다.
M1_DEPLOY_SSH_HOSTNAME=change-me-ssh-public-hostname
# OpenSSH 개인키 전체 내용을 줄바꿈 포함 그대로 저장합니다.
M1_DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
change-me
-----END OPENSSH PRIVATE KEY-----
# ssh-keyscan 등으로 수집한 known_hosts 내용을 그대로 저장합니다.
# workflow는 cloudflared tcp 프록시의 127.0.0.1:2222 로 SSH를 연결하므로 같은 형식으로 맞춥니다.
# 호스트 기기에서 직접 찾는다면 sudo cat /etc/ssh/ssh_host_ed25519_key.pub 명령어를 통해 확인합니다.
M1_DEPLOY_KNOWN_HOSTS=[127.0.0.1]:2222 ssh-ed25519 <키 값>
# Cloudflare Access 서비스 토큰 쌍입니다.
CF_ACCESS_SERVICE_TOKEN_ID=change-me-cf-access-token-id
CF_ACCESS_SERVICE_TOKEN_SECRET=change-me-cf-access-token-secret
# 비-fork mirror 저장소의 owner/repo 형식 값입니다. 예: earlydreamer/semicolon-backend-mirror
MIRROR_REPOSITORY=change-me-owner/change-me-repo
# fine-grained PAT를 권장합니다. mirror 저장소 Contents 권한만 write로 부여합니다.
MIRROR_REPO_TOKEN=github_pat_change_me
