# GitHub Actions Variables example
#
# 민감하지 않은 배포/런타임 설정은 Variables로 관리합니다.
# secret 슬롯을 아끼고, 대시보드에서 개별 수정 가능하게 유지하는 목적입니다.

# ----- Deploy control / public hosts -----
DOCKER_USERNAME=change-me-docker-username
K8S_NAMESPACE=semicolon
REMOTE_WORKSPACE=deploy/semicolon-backend
DEPLOY_INGRESS_MODE=local
DEPLOY_ENABLE_MONITORING=true
DEPLOY_ENABLE_CERT_MANAGER=false
PUBLIC_WEB_HOST=dukku.earlydreamer.dev
PUBLIC_API_HOST=api-dukku.earlydreamer.dev
PUBLIC_GRAFANA_HOST=grafana-dukku.earlydreamer.dev
CORS_ALLOWED_ORIGINS=https://dukku.earlydreamer.dev,https://www.dukku.earlydreamer.dev

# ----- Remote deploy identity (non-secret) -----
M1_DEPLOY_USER=change-me-remote-user
M1_DEPLOY_SSH_HOSTNAME=change-me-ssh-public-hostname

# ----- App runtime (non-secret) -----
INIT_ADMIN_EMAIL=change-me-admin-email@example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=change-me-bucket-name
OBJECT_STORAGE_ENDPOINT=https://change-me-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_PATH_STYLE_ACCESS_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=change-me-google-client-id
GRAFANA_ADMIN_USER=admin
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me-mail-username@example.com
