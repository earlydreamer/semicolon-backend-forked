# semicolon 백엔드 초기 기동용 예시 환경 변수입니다.
# 아래 파일을 복사해 루트 `.env`를 만든 뒤 실제 값으로 교체합니다.
#   cp .env.example .env

# ----- Docker network -----
DOCKER_SHARED_NETWORK=dukku-network

# ----- GitHub Actions deploy control -----
K8S_NAMESPACE=semicolon
REMOTE_WORKSPACE=deploy/semicolon-backend
DEPLOY_INGRESS_MODE=local
DEPLOY_ENABLE_MONITORING=true
DEPLOY_ENABLE_CERT_MANAGER=false

# ----- Public hosts -----
PUBLIC_WEB_HOST=dukku.earlydreamer.dev
PUBLIC_API_HOST=api-dukku.earlydreamer.dev
PUBLIC_GRAFANA_HOST=grafana.api-dukku.earlydreamer.dev

# ----- Local runtime (IDE / host nginx) -----
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=15432
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=16379
LOCAL_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
LOCAL_ELASTICSEARCH_URL=http://localhost:19200
LOCAL_ES_PORT=19200
LOCAL_MONGO_HOST=localhost
LOCAL_MONGO_PORT=17017
LOCAL_GRAFANA_UPSTREAM=host.docker.internal:13000
LOCAL_GRAFANA_PORT=13000

# ----- Grafana -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# ----- Kafka (deployment defaults) -----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ----- Redis (deployment defaults) -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Mongo (deployment defaults) -----
MONGO_HOST=mongodb-service
MONGO_PORT=27017

# ----- DB (deployment defaults) -----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=semicolon
AI_DB_NAME=ai_service
AUTH_DB_NAME=auth_service
USER_DB_NAME=user_service
PRODUCT_DB_NAME=product_service
ORDER_DB_NAME=order_service
PAYMENT_DB_NAME=payment_service
DEPOSIT_DB_NAME=deposit_service
COUPON_DB_NAME=coupon_service
SETTLEMENT_DB_NAME=settlement_service
DB_USERNAME=postgres
DB_PASSWORD=change-me-db-password
DB_SSLMODE=disable
DB_HIKARI_MINIMUM_IDLE=2
DB_HIKARI_MAXIMUM_POOL_SIZE=20
DB_HIKARI_IDLE_TIMEOUT=30000
DB_HIKARI_CONNECTION_TIMEOUT=30000
DB_HIKARI_MAX_LIFETIME=1800000
HIBERNATE_DDL_AUTO=update

# ----- Elasticsearch (deployment defaults) -----
ELASTICSEARCH_URL=http://elasticsearch:9200
AI_INIT_ENABLED=true
PRODUCT_INIT_ENABLED=true
PRODUCT_INIT_CLEAR_ES_ON_STARTUP=false
PRODUCT_REINDEX_ON_STARTUP=true

# ----- Showcase reset -----
SHOWCASE_RESET_ENABLED=true
SHOWCASE_RESET_CRON=0 0 * * *
SHOWCASE_RESET_TIMEZONE=Asia/Seoul
SHOWCASE_RESET_TIMEOUT_SECONDS=900

# ----- JWT / Security -----
JWT_ACCESS_SECRET=change-me-jwt-access-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
CRYPTO_KEY=change-me-crypto-key
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# ----- Toss Payments -----
TOSS_API_SECRET_KEY=change-me-toss-api-secret-key
TOSS_CALLBACK_BASE_URL=https://dukku.earlydreamer.dev

# ----- AWS S3 -----
AWS_ACCESS_KEY=change-me-aws-access-key
AWS_SECRET_KEY=change-me-aws-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=change-me-s3-bucket

# ----- Mail -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me-mail-username@example.com
EMAIL_PASSWORD=change-me-mail-app-password

# ----- OAuth2 -----
GOOGLE_OAUTH_CLIENT_ID=change-me-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api-dukku.earlydreamer.dev/login/oauth2/code/google
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=https://dukku.earlydreamer.dev/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=https://dukku.earlydreamer.dev/oauth/google/callback

# ----- Redirect (local IDE / host nginx defaults; compose / k8s override) -----
INTERNAL_BACK_URL=http://localhost
SERVICE_USER_URL=http://localhost

# ----- Internal client URLs (local IDE / host nginx defaults; compose / k8s override) -----
CUSTOM_CLIENT_USER_URL=http://localhost
CUSTOM_CLIENT_PRODUCT_URL=http://localhost
CUSTOM_CLIENT_CART_URL=http://localhost
CUSTOM_CLIENT_SETTLEMENT_URL=http://localhost
CUSTOM_CLIENT_ORDER_URL=http://localhost
CUSTOM_CLIENT_PAYMENT_URL=http://localhost
CUSTOM_CLIENT_COUPON_URL=http://localhost
CUSTOM_CLIENT_DEPOSIT_URL=http://localhost
CUSTOM_CLIENT_AI_URL=http://localhost

# ----- Metrics / Alerting -----
SLACK_WEBHOOK_URL_GRAFANA=https://hooks.slack.com/services/change/me
SLACK_WEBHOOK_URL_SETTLEMENT=https://hooks.slack.com/services/change/me

# ----- AI -----
OPENAI_API_KEY=change-me-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# ----- CORS / Email verification -----
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1,http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://127.0.0.1:3000,http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173,https://dukku.earlydreamer.dev,https://www.dukku.earlydreamer.dev
EMAIL_VERIFICATION_BASE_URL=https://api-dukku.earlydreamer.dev
EMAIL_VERIFICATION_SUCCESS_REDIRECT_URL=https://dukku.earlydreamer.dev/email/verify

# ----- System deposit -----
SYSTEM_DEPOSIT_PASSWORD=change-me-system-deposit-password
