<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ============================================ -->
    <!-- 프로퍼티 설정                                  -->
    <!-- ============================================ -->
    <!-- Spring Boot 설정에서 읽어오는 동적 프로퍼티 -->
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="settlement-service"/>
    <springProperty scope="context" name="KAFKA_BOOTSTRAP_SERVERS" source="spring.kafka.bootstrap-servers" defaultValue="localhost:19092"/>

    <!-- 로컬 프로퍼티 (하위 호환성) -->
    <property name="LOG_PATH" value="./log"/>

    <!-- ============================================ -->
    <!-- 1. 콘솔 Appender (개발용 + JSON 로깅)         -->
    <!-- ============================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- MDC 키 포함 -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>requestUri</includeMdcKeyName>
            <includeMdcKeyName>requestMethod</includeMdcKeyName>
            <!-- 서비스명 고정 추가 -->
            <customFields>{"serviceName":"${SERVICE_NAME}"}</customFields>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- 2. 파일 Appender (백업용 + JSON 로깅)         -->
    <!-- ============================================ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${SERVICE_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"serviceName":"${SERVICE_NAME}"}</customFields>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- 3. Kafka Appender (중앙 로그 수집)              -->
    <!-- ============================================ -->
    <appender name="KAFKA" class="com.github.danielwegener.logback.kafka.KafkaAppender">
        <!-- INFO 이상만 Kafka로 전송 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>

        <!-- traceId가 있는 로그만 Kafka로 전송 (MDC 컨텍스트 필터) -->
        <filter class="dukku.common.global.logging.MdcTraceFilter"/>

        <!-- Kafka Topic 이름 -->
        <topic>msa-logs</topic>

        <!-- Key Partitioning: 같은 서비스 로그는 같은 파티션으로 -->
        <keyingStrategy class="dukku.common.global.logging.ServiceNameKeyingStrategy">
            <serviceName>${SERVICE_NAME}</serviceName>
        </keyingStrategy>

        <!-- 전송 실패 시 처리 (콘솔로 fallback) -->
        <deliveryStrategy class="com.github.danielwegener.logback.kafka.delivery.AsynchronousDeliveryStrategy"/>

        <!-- Kafka Producer 설정 -->
        <producerConfig>bootstrap.servers=${KAFKA_BOOTSTRAP_SERVERS}</producerConfig>
        <producerConfig>acks=1</producerConfig>
        <producerConfig>linger.ms=100</producerConfig>
        <producerConfig>batch.size=16384</producerConfig>
        <producerConfig>buffer.memory=33554432</producerConfig>
        <producerConfig>max.block.ms=5000</producerConfig>
        <producerConfig>retries=3</producerConfig>

        <!-- JSON 포맷 인코더 -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>requestUri</includeMdcKeyName>
            <includeMdcKeyName>requestMethod</includeMdcKeyName>
            <includeMdcKeyName>clientIp</includeMdcKeyName>
            <customFields>{"serviceName":"${SERVICE_NAME}"}</customFields>
        </encoder>

        <!-- Kafka Appender 전용 설정 -->
        <appendTimestamp>true</appendTimestamp>
    </appender>

    <!-- ============================================ -->
    <!-- 4. Async Kafka Appender (성능 최적화)          -->
    <!-- ============================================ -->
    <appender name="ASYNC_KAFKA" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="KAFKA"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ============================================ -->
    <!-- 환경별 프로파일 설정                            -->
    <!-- ============================================ -->

    <!-- DEV 환경: 콘솔 + Kafka -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- dukku 패키지 로그만 Kafka로 전송 -->
        <logger name="dukku" level="INFO" additivity="true">
            <appender-ref ref="ASYNC_KAFKA"/>
        </logger>

        <!-- Kafka 클라이언트 내부 로그 억제 (피드백 루프 방지) -->
        <logger name="org.apache.kafka" level="WARN"/>

        <!-- SQL 로깅 -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
    </springProfile>

    <!-- RELEASE/PROD 환경: 콘솔 + 파일 + Kafka -->
    <springProfile name="release,prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- dukku 패키지 로그만 Kafka로 전송 -->
        <logger name="dukku" level="INFO" additivity="true">
            <appender-ref ref="ASYNC_KAFKA"/>
        </logger>

        <!-- Kafka 클라이언트 내부 로그 억제 (피드백 루프 방지) -->
        <logger name="org.apache.kafka" level="WARN"/>

        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    </springProfile>

    <!-- TEST 환경: Kafka 비활성화 -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 프로파일 미지정 시 기본 설정: 콘솔 + Kafka -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="dukku" level="INFO" additivity="true">
            <appender-ref ref="ASYNC_KAFKA"/>
        </logger>

        <logger name="org.apache.kafka" level="WARN"/>
    </springProfile>

</configuration>
