# semicolon k3d 로컬용 .env 템플릿
# 실제 운영 시크릿은 커밋하지 말고 로컬 또는 CI에서 주입하세요.
# 빈 값은 create-secrets.sh 에서 제외되어 서비스 기본값을 사용합니다.

SPRING_PROFILES_ACTIVE=release

# database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# cache / broker / search
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
ELASTICSEARCH_URL=http://elasticsearch:9200
MONGO_HOST=mongodb-service
MONGO_PORT=27017

# security / internal
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
CRYPTO_KEY=local-crypto-key-change-me
INTERNAL_SERVICE_TOKEN=local-internal-service-token
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
INTERNAL_BACK_URL=http://auth-service
FRONTEND_BASE_URL=http://localhost:3000

# ai / notifications
OPENAI_API_KEY=local-openai-placeholder
OPENAI_CHAT_MODEL=gpt-4o-mini
AI_INIT_ENABLED=false
SLACK_WEBHOOK_URL_SETTLEMENT=http://localhost/disabled-webhook
SLACK_WEBHOOK_URL_GRAFANA=http://localhost/disabled-webhook

# mail / auth redirect
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=local-mail-user
EMAIL_PASSWORD=local-mail-password
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080
EMAIL_VERIFICATION_SUCCESS_REDIRECT_URL=http://localhost:3000/email/verify
GOOGLE_OAUTH_CLIENT_ID=local-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=local-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/google/callback

# payment / deposit
SYSTEM_DEPOSIT_PASSWORD=local-system-deposit-password
TOSS_API_SECRET_KEY=local-toss-secret-key
TOSS_CALLBACK_BASE_URL=http://localhost:8080

# product / storage
AWS_ACCESS_KEY=local-aws-access-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=local-semicolon-bucket
AWS_SECRET_KEY=local-aws-secret-key
PRODUCT_INIT_CLEAR_ES_ON_STARTUP=false
PRODUCT_INIT_ENABLED=false
PRODUCT_REINDEX_ON_STARTUP=false

# service overrides (기본값 사용 시 비워 둠)
CUSTOM_CLIENT_AI_URL=
CUSTOM_CLIENT_COUPON_URL=
CUSTOM_CLIENT_DEPOSIT_URL=
CUSTOM_CLIENT_ORDER_URL=
CUSTOM_CLIENT_PAYMENT_URL=
CUSTOM_CLIENT_PRODUCT_URL=
CUSTOM_CLIENT_SETTLEMENT_URL=
CUSTOM_CLIENT_USER_URL=
SERVICE_USER_URL=

# pool tuning (기본값 사용 시 비워 둠)
DB_HIKARI_CONNECTION_TIMEOUT=
DB_HIKARI_IDLE_TIMEOUT=
DB_HIKARI_MAX_LIFETIME=
DB_HIKARI_MAXIMUM_POOL_SIZE=
DB_HIKARI_MINIMUM_IDLE=
HIBERNATE_DDL_AUTO=

# monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_UPSTREAM=http://grafana:3000
