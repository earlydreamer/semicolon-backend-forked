#!/bin/sh
set -eu

DATABASES="${SHOWCASE_DATABASES:-ai_service auth_service user_service product_service order_service payment_service deposit_service coupon_service settlement_service}"

database_exists() {
    db="$1"
    psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres -tAc \
        "SELECT 1 FROM pg_database WHERE datname = '$db'" | grep -q 1
}

create_database_if_missing() {
    db="$1"

    if database_exists "$db"; then
        echo "Database already exists: $db"
        return 0
    fi

    echo "Creating database: $db"
    psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres -c "CREATE DATABASE $db"
}

drop_database_if_exists() {
    db="$1"

    if ! database_exists "$db"; then
        echo "Database already absent: $db"
        return 0
    fi

    echo "Dropping database: $db"
    psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres <<EOSQL
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = '$db'
  AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS $db;
EOSQL
}

recreate_database() {
    db="$1"
    drop_database_if_exists "$db"
    create_database_if_missing "$db"
}

install_extensions() {
    db="$1"

    echo "Installing extensions on: $db"
    psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$db" <<EOSQL
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgroonga;
EOSQL
}

initialize_showcase_databases() {
    for db in $DATABASES; do
        create_database_if_missing "$db"
        install_extensions "$db"
    done

    echo "All showcase databases initialized successfully."
}

reset_showcase_databases() {
    for db in $DATABASES; do
        recreate_database "$db"
        install_extensions "$db"
    done

    echo "All showcase databases reset successfully."
}
